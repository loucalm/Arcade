* text=auto

# Unity YAML : fins de ligne LF pour limiter les diffs parasites
*.unity      text eol=lf
*.prefab     text eol=lf
*.asset      text eol=lf
*.meta       text eol=lf
*.mat        text eol=lf
*.anim       text eol=lf
*.controller text eol=lf
*.cs         text eol=lf diff=csharp
*.json       text eol=lf
*.md         text eol=lf

# Binaires
*.png binary
*.jpg binary
*.psd binary
*.wav binary
*.ogg binary
*.mp3 binary
*.mp4 binary
*.ttf binary
*.otf binary
*.fbx binary
